---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import AstroIcon from './icons/Astro.astro'
const TAGS = {
    NEXT: {
        name: "Next.js",
        class: "bg-black text-white",
        icon: NextJS,
    },
    ASTRO: {
        name: "Astro",
        class: "bg-[#FF5D01] text-white",
        icon: AstroIcon,
    },
    TAILWIND: {
        name: "Tailwind CSS",
        class: "bg-[#003159] text-white",
        icon: Tailwind,
    },
}
const PROJECTS = [
    {
        title: "Arqso - Grupo Constructor",
        description:
            "Modernización digital completa. Migración de su infraestructura (WordPress) y desarrollé desde cero una nueva landing page de alto rendimiento con Astro y Tailwind CSS. El resultado optimizó drásticamente la velocidad de carga (Core Web Vitals), mejoró el SEO y renovó la identidad digital de la firma para destacar sus servicios y portafolio.",
        link: "https://arqso.com/",
        image: "/projects/arqso.webp",
        tags: [TAGS.ASTRO, TAGS.TAILWIND],
        github: null,
    },
    {
        title: "GogArq - Arquitectura y Diseño",
        description:
            "Plataforma digital para la promoción de servicios de arquitectura, interiorismo y administración de propiedades. Estructura modular diseñada para presentar claramente un catálogo de servicios diverso. Desarrollo estático de alto rendimiento con Astro y Tailwind CSS.",
        link: "https://gogarq.com/",
        image: "/projects/gogarq.webp",
        tags: [TAGS.ASTRO, TAGS.TAILWIND],
        github: null,
    },
    {
        title: "Zenzat Consultoría",
        description:
            "Sitio web institucional diseñado para consolidar la presencia digital de la firma. Enfoque en una arquitectura de información clara para comunicar eficazmente la misión, visión y servicios de la consultora. Desarrollado desde cero con Astro y Tailwind CSS.",
        link: "https://zenzat.com.mx/",
        image: "/projects/zenzat.webp",
        tags: [TAGS.ASTRO, TAGS.TAILWIND],
        github: null,
    },
    {
        title: "AEVA Inmobiliaria",
        description:
            "Plataforma digital informativa para la promoción de servicios inmobiliarios. Interfaz limpia y directa que prioriza la accesibilidad de la información y la presentación de servicios. Implementación eficiente y ligera con Astro y Tailwind CSS.",
        link: "https://aevainmobiliaria.com.mx/",
        image: "/projects/aeva.webp",
        tags: [TAGS.ASTRO, TAGS.TAILWIND],
        github: null,
    },

]
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
        PROJECTS.map(({image, title, description, tags, link, github}) => (
                <article class="flex flex-col space-y-4 group">

                    <div class="w-full">
                        <div class="relative flex flex-col items-center gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
                            {/* Ajustamos la altura de la imagen para que sea uniforme */}
                            <img alt={title}
                                 class="object-cover object-top w-full h-64 transition duration-500 md:scale-110 md:group-hover:scale-105"
                                 loading="lazy" src={image}/>
                        </div>
                    </div>

                    <div class="w-full">
                        <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
                            {title}
                        </h3>
                        <div class="flex flex-wrap mt-2">
                            <ul class="flex flex-row mb-2 gap-x-2">
                                {tags.map((tag) => (
                                        <li>
                                    <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}>
                                        <tag.icon class="size-4"/>
                                        {tag.name}
                                    </span>
                                        </li>
                                ))}
                            </ul>

                            <div class="mt-2 text-gray-700 dark:text-gray-400 text-pretty">
                                {description}
                            </div>

                            <footer class="flex items-end justify-start mt-4 gap-x-4">
                                {github && (
                                        <LinkButton href={github}>
                                            <GitHub class="size-6"/>
                                            Code
                                        </LinkButton>
                                )}
                                {link && (
                                        <LinkButton href={link}>
                                            <Link class="size-4"/>
                                            Preview
                                        </LinkButton>
                                )}
                            </footer>
                        </div>
                    </div>
                </article>
        ))
    }
</div>



